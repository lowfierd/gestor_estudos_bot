# Token fornecido pelo @BotFather no Telegram
BOT_TOKEN=seu_token_aqui

# IDs numéricos do Telegram de você e da sua namorada (obtenha enviando /id para o @userinfobot)
USER_A_ID=123456789
USER_B_ID=987654321

# (Opcional) ID de um grupo mútuo onde o bot está presente para enviar os avisos e rankings
GROUP_CHAT_ID=-1001234567890

# URL do banco de dados (por padrão cria um arquivo SQLite local)
DATABASE_URL=sqlite+aiosqlite:///database/gestor_estudos.db
